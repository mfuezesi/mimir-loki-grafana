// ── Alloy In-Compose Configuration ───────────────────────────────────────────
// Config für den Alloy-Service innerhalb des Docker-Compose-Stacks.
// Verbindet sich direkt mit Mimir im internen "monitoring"-Netzwerk —
// kein Traefik-Roundtrip, kein BasicAuth. X-Scope-OrgID wird direkt gesetzt.
//
// Erforderliche Umgebungsvariable (aus .env):
//   ALLOY_MIMIR_TENANT  Tenant-ID, z.B. "host-monitoring"
//
// Host-Metriken werden über Bind-Mounts aus dem Container heraus gelesen:
//   /host/proc  → /proc des Hosts
//   /host/sys   → /sys des Hosts
//   /host/root  → / des Hosts
// ────────────────────────────────────────────────────────────────────────────────

// ── Host-Metriken ─────────────────────────────────────────────────────────────
prometheus.exporter.unix "host" {
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  rootfs_path    = "/host/root"
  udev_data_path = "/host/root/run/udev/data"
}

// ── Scrape ────────────────────────────────────────────────────────────────────
prometheus.scrape "host_metrics" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.add_labels.receiver]

  scrape_interval = "60s"
  scrape_timeout  = "10s"
}

// ── Labels ────────────────────────────────────────────────────────────────────
prometheus.relabel "add_labels" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "job"
    replacement  = "node"
  }

  // Hostname als 'instance' setzen (liest aus dem Container-Env)
  rule {
    target_label = "instance"
    replacement  = env("HOSTNAME")
  }
}

// ── Remote Write an Mimir (intern, direkt) ────────────────────────────────────
// Kein BasicAuth — Alloy läuft im selben Docker-Netzwerk wie Mimir.
// X-Scope-OrgID wird direkt gesetzt (kein Traefik-Zwischenschritt).
prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:8080/api/v1/push"

    headers = {
      "X-Scope-OrgID" = env("ALLOY_MIMIR_TENANT"),
    }

    queue_config {
      capacity             = 10000
      max_shards           = 4
      min_shards           = 1
      max_samples_per_send = 2000
      batch_send_deadline  = "5s"
      min_backoff          = "30ms"
      max_backoff          = "5s"
    }
  }
}

