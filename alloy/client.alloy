// ── Alloy Client Configuration ───────────────────────────────────────────────
// Für externe Client-Maschinen (Docker oder nativ/systemd).
//
// Docker-Betrieb: siehe alloy/docker-compose.yml im Monitoring-Stack-Repo.
// Host-Metriken werden über Bind-Mounts aus dem Container gelesen:
//   /host/proc  → /proc des Hosts
//   /host/sys   → /sys des Hosts
//   /host/root  → / des Hosts
//
// Nativ/systemd: procfs_path, sysfs_path, rootfs_path-Zeilen entfernen —
// Alloy liest dann direkt /proc, /sys, / des Hosts.
//
// Erforderliche Umgebungsvariablen:
//   MIMIR_URL      https://mimir.example.com/t/<tenant-id>/api/v1/push
//   MIMIR_USER     BasicAuth Benutzername
//   MIMIR_PASSWORD BasicAuth Passwort
//
// X-Scope-OrgID wird NICHT gesetzt — Traefik injiziert ihn nach der
// BasicAuth-Authentifizierung anhand des URL-Pfads (/t/<tenant-id>/).
// ────────────────────────────────────────────────────────────────────────────────

// ── Host-Metriken ─────────────────────────────────────────────────────────────
prometheus.exporter.unix "host" {
  // Pfade für Docker-Betrieb (Bind-Mounts).
  // Nativ/systemd: diese drei Zeilen entfernen.
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  rootfs_path    = "/host/root"
  udev_data_path = "/host/root/run/udev/data"
}

// ── Scrape ────────────────────────────────────────────────────────────────────
prometheus.scrape "host_metrics" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.add_labels.receiver]

  scrape_interval = "60s"
  scrape_timeout  = "10s"
}

// ── Labels ────────────────────────────────────────────────────────────────────
prometheus.relabel "add_labels" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "job"
    replacement  = "node"
  }

  rule {
    target_label = "instance"
    replacement  = env("HOSTNAME")
  }
}

// ── Remote Write an Mimir (via Traefik BasicAuth) ─────────────────────────────
prometheus.remote_write "mimir" {
  endpoint {
    url = env("MIMIR_URL")

    basic_auth {
      username = env("MIMIR_USER")
      password = env("MIMIR_PASSWORD")
    }

    tls_config {
      insecure_skip_verify = false
    }

    queue_config {
      capacity             = 10000
      max_shards           = 4
      min_shards           = 1
      max_samples_per_send = 2000
      batch_send_deadline  = "5s"
      min_backoff          = "30ms"
      max_backoff          = "5s"
    }
  }
}

// ── Optional: Alloy-Selbst-Monitoring ─────────────────────────────────────────
