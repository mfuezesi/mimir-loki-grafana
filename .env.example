# ── Domains (kein https://, kein trailing slash) ──────────────────────────────
GRAFANA_DOMAIN=grafana.example.com
MIMIR_DOMAIN=mimir.example.com
LOKI_DOMAIN=loki.example.com

# ── Traefik ───────────────────────────────────────────────────────────────────
# Traefik-Entrypoint: "websecure" (HTTPS) oder "web" (HTTP)
TRAEFIK_ENTRYPOINT=websecure
# TLS-Cert-Resolver (muss zum Traefik-certResolvers Key passen)
# Leer lassen für kein ACME (dann tls.certresolver-Label entfernen)
TRAEFIK_CERTRESOLVER=letsencrypt

# ── Mimir Tenants ─────────────────────────────────────────────────────────────
# Tenant-ID für Grafanas internes Mimir-Datasource
MIMIR_GRAFANA_TENANT=grafana-internal

# Tenant-Liste für Cross-Tenant-Datasource "All Tenants" (| getrennt)
MIMIR_FEDERATION_TENANTS=team-alpha|team-beta

# BasicAuth-Credentials pro Tenant (htpasswd-Format, $ als $$ escapen)
# Generieren: echo $(htpasswd -nb USERNAME PASSWORD) | sed -e 's/\$/\$\$/g'
MIMIR_BASICAUTH_TEAM_ALPHA=user:$$apr1$$replace$$withreal$$hash$$here
MIMIR_BASICAUTH_TEAM_BETA=user:$$apr1$$replace$$withreal$$hash$$here

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
# Generieren mit: openssl rand -hex 32
GF_SECURITY_SECRET_KEY=changeme_generate_a_real_secret_with_openssl_rand_hex_32

# ── Alloy (optionaler In-Compose-Service) ────────────────────────────────────
# Tenant-ID für den lokalen Alloy-Service (direkter Mimir-Zugriff, kein BasicAuth)
ALLOY_MIMIR_TENANT=host-monitoring

# ── Docker Compose ────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=monitoring
# Alloy-Profil dauerhaft aktivieren (alternativ: --profile alloy beim Starten)
# COMPOSE_PROFILES=alloy
